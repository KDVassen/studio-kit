# Security and caching headers for static files (Cloudflare Workers static assets).
# Script and style hashes come from Astro's own CSP (astro.config.ts) as a <meta> tag;
# frame-ancestors only works as a header, so it lives here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Hashed build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
