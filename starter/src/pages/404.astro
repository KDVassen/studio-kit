---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap py-24">
    <h1 class="text-4xl font-bold tracking-tight">We couldn't find that page</h1>
    <p class="mt-6 prose-width text-lg muted">It may have moved, or the link may have a typo.</p>
    <p class="mt-8"><a href="/" class="btn btn-primary min-h-12">Go to the home page</a></p>
  </section>
</Base>
